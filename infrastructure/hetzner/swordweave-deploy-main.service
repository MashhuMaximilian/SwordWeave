[Unit]
Description=Deploy SwordWeave from GitHub main
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
ConditionPathExists=/etc/swordweave/production/autodeploy-enabled

[Service]
Type=oneshot
User=root
UMask=0077
Nice=10
ExecStart=/usr/bin/python3 /opt/swordweave/operations/deploy-main.py
TimeoutStartSec=55min
