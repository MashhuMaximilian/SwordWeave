{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "swordweave": {
      "type": "streamable-http",
      "url": "https://www.swordweave.quest/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "mixed",
            "client": {
              "mode": "provided",
              "tokenEndpointAuthMethod": "none"
            },
            "baseScopes": ["swordweave:read"],
            "defaultScopes": []
          }
        }
      }
    }
  }
}
