SW_DEPLOYMENT_MODE=
SW_UPLOAD_BACKEND=
SW_R2_ENDPOINT=
SW_R2_UPLOAD_BUCKET=
SW_R2_ACCESS_KEY_ID=
SW_R2_SECRET_ACCESS_KEY=
SW_UPLOAD_ALIAS_FILE=
SW_UPLOAD_ALIAS_SHA256=
SW_UPLOAD_INVENTORY_SHA256=
SW_READINESS_SECRET=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Companion transport is disabled until explicitly configured.
MCP_RESOURCE_URL=
MCP_CLERK_ISSUER=
MCP_READ_ENABLED=false
MCP_WRITE_ENABLED=false
MCP_FIXTURE_ENABLED=false
MCP_STAGING_REVIEW_ENABLED=false
MCP_CHARACTER_EDIT_READ_ENABLED=false
MCP_CHARACTER_EDIT_WRITE_ENABLED=false
MCP_CHARACTER_VERSION_PROPOSAL_READS_ENABLED=false
MCP_CHARACTER_VERSION_PROPOSAL_WRITE_ENABLED=false
MCP_CHARACTER_PLAY_READ_ENABLED=false
MCP_CHARACTER_PLAY_WRITE_ENABLED=false
MCP_CHARACTER_COMPANIONS_READ_ENABLED=false
MCP_CURSOR_HMAC_SECRET=
# Fixture requires a Clerk development key, an isolated sw_companion_test DB,
# the exact permitted database host and two comma-separated fictional user UUIDs.
MCP_FIXTURE_DATABASE_HOST=
MCP_FIXTURE_USER_IDS=

# Exact public domain-verification token supplied by the OpenAI Plugins portal.
OPENAI_APPS_CHALLENGE_TOKEN=

# First-party /api/contact delivery; all credentials stay server-side.
# Enable after verifying delivery and configuring an edge rate limit.
CONTACT_FORM_ENABLED=false
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_RECIPIENT=
